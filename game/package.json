{
  "name": "battletech-game",
  "private": true,
  "version": "0.1.93",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run svelte-check && npm run lint && npm run test",
    "shot": "node scripts/screenshot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sim": "vite-node src/sim/cli.ts --",
    "camp": "vite-node src/sim/campaign/cli.ts --",
    "galaxy": "vite-node scripts/galaxystat.ts --",
    "econstat": "vite-node scripts/econstat.ts --",
    "supplystat": "vite-node scripts/supplystat.ts --",
    "frontstat": "vite-node scripts/frontstat.ts --",
    "boardstat": "vite-node scripts/boardstat.ts --",
    "mapstat": "vite-node scripts/mapstat.ts --",
    "mapfair": "vite-node scripts/mapfair.ts --",
    "qualitystat": "vite-node scripts/qualitystat.ts --",
    "fastcalib": "vite-node scripts/fastcalib.ts --",
    "threatcalib": "vite-node scripts/threatcalib.ts --",
    "worldstat": "vite-node scripts/worldstat.ts --",
    "worldpairs": "vite-node scripts/worldpairs.ts --",
    "realm": "vite-node scripts/realmstat.ts --",
    "biomestat": "vite-node scripts/biomestat.ts --",
    "rolestat": "vite-node scripts/rolestat.ts --",
    "familystat": "vite-node scripts/familystat.ts --",
    "loadoutstat": "vite-node scripts/loadoutstat.ts --",
    "i18n:allowlist": "vite-node scripts/i18n-allowlist.ts --",
    "svelte-check": "svelte-check --threshold error"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.39.0",
    "marked": "^18.0.11",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-node": "^6.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
